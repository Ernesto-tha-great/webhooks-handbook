{
  "name": "webhooks-handbook",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable webhook delivery in Node.js and TypeScript, built to the Standard Webhooks spec: both the sending and the receiving side.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sender": "node --no-warnings --import tsx src/sender/main.ts",
    "receiver": "node --no-warnings --import tsx src/receiver/main.ts",
    "chaos": "node --no-warnings --import tsx scripts/chaos.ts",
    "test": "node --no-warnings --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "chart": "node --no-warnings --import tsx scripts/chart.ts"
  },
  "dependencies": {
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
